NODE_ENV=development
PORT=3000

DB_HOST=localhost
DB_PORT=5432
DB_NAME=hiregen
DB_USER=postgres
DB_PASSWORD=replace-with-your-db-password
DATABASE_URL=postgres://postgres:replace-with-your-db-password@localhost:5432/hiregen

JWT_SECRET=replace-with-a-32-character-minimum-secret
REFRESH_SECRET=replace-with-a-different-32-character-minimum-secret

FRONTEND_URL=http://localhost:5173

ADMIN_EMAIL=admin@hiregen.ai
ADMIN_PASSWORD=Admin@123
ADMIN_NAME=Admin User

# AI Gateway (Groq, Grok / xAI, OpenAI, or compatible endpoint)
# AI will automatically generate personalized outreach drafts. If empty, uses high-converting deterministic template.
GROQ_API_KEY=
GROK_API_KEY=
AI_GATEWAY_BASE_URL=https://api.groq.com/openai/v1
AI_GATEWAY_API_KEY=
AI_GATEWAY_MODEL=llama-3.3-70b-versatile

# Automated Background Radar & Python Deep Scraper Microservice
AUTO_SYNC_INTERVAL_MINUTES=10
AUTO_PILOT_DISPATCH=false
PYTHON_SCRAPER_URL=http://scraper-engine:5050

# Email Dispatch Configuration
# When approved or in Autopilot mode, emails will be sent via SMTP or Resend REST API.
# If not configured, system defaults to safe simulation mode with full PostgreSQL logging.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
RESEND_API_KEY=

# n8n webhook authentication (SRS §14/§18)
N8N_WEBHOOK_API_KEY=replace-with-real-api-key
N8N_WEBHOOK_SECRET=replace-with-real-hmac-secret