NODE_ENV=development
PORT=3000

DB_HOST=localhost
DB_PORT=5432
DB_NAME=hiregen
DB_USER=postgres
DB_PASSWORD=replace-with-your-db-password
DATABASE_URL=postgres://postgres:replace-with-your-db-password@localhost:5432/hiregen

JWT_SECRET=replace-with-a-32-character-minimum-secret
REFRESH_SECRET=replace-with-a-different-32-character-minimum-secret

FRONTEND_URL=http://localhost:5173

ADMIN_EMAIL=admin@hiregen.ai
ADMIN_PASSWORD=Admin@123

# Needed for the Research Agent (2.4) — POST /api/v1/leads/:id/research.
# Any OpenAI-compatible chat-completions endpoint works (OpenAI, Groq,
# a self-hosted gateway, etc.) — see services/aiGateway.service.js.
AI_GATEWAY_BASE_URL=https://api.groq.com/openai/v1
AI_GATEWAY_API_KEY=replace-with-real-key
AI_GATEWAY_MODEL=llama-3.3-70b-versatile

# n8n webhook authentication (SRS §14/§18)
N8N_WEBHOOK_API_KEY=replace-with-real-api-key
N8N_WEBHOOK_SECRET=replace-with-real-hmac-secret