{
  "name": "Workflow 10 - Failure Watchdog",
  "nodes": [
    {
      "parameters": {},
      "type": "n8n-nodes-base.errorTrigger",
      "typeVersion": 1,
      "position": [0, 0],
      "id": "err-trigger-01",
      "name": "Error Trigger"
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "wf-name",
              "name": "workflowName",
              "value": "={{ $json.workflow.name }}",
              "type": "string"
            },
            {
              "id": "exec-id",
              "name": "executionId",
              "value": "={{ $json.execution.id }}",
              "type": "string"
            },
            {
              "id": "exec-url",
              "name": "executionUrl",
              "value": "={{ $json.execution.url }}",
              "type": "string"
            },
            {
              "id": "err-msg",
              "name": "errorMessage",
              "value": "={{ $json.execution.error.message }}",
              "type": "string"
            },
            {
              "id": "failed-at",
              "name": "failedAt",
              "value": "={{ $now.toISO() }}",
              "type": "string"
            }
          ]
        },
        "options": {}
      },
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.5,
      "position": [224, 0],
      "id": "extract-failure-data",
      "name": "Extract Failure Data"
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $env.BACKEND_BASE_URL }}/api/v1/webhooks/workflow-failure",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            { "name": "x-api-key", "value": "={{ $env.N8N_WEBHOOK_API_KEY }}" },
            { "name": "x-signature", "value": "={{ $env.N8N_WEBHOOK_SIGNATURE }}" }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"workflowName\": \"{{ $json.workflowName }}\",\n  \"n8nExecutionId\": \"{{ $json.executionId }}\",\n  \"status\": \"FAILED\",\n  \"errorDetail\": \"{{ $json.errorMessage }}\",\n  \"finishedAt\": \"{{ $json.failedAt }}\"\n}",
        "options": {}
      },
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.4,
      "position": [448, -96],
      "id": "log-to-workflow-runs",
      "name": "Log to workflow_runs"
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $env.SLACK_WEBHOOK_URL_DEVOPS }}",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"text\": \":rotating_light: *Workflow Failed*\\n*Workflow:* {{ $json.workflowName }}\\n*Error:* {{ $json.errorMessage }}\\n*Execution:* {{ $json.executionUrl }}\"\n}",
        "options": {}
      },
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.4,
      "position": [448, 96],
      "id": "slack-alert",
      "name": "Slack Alert to On-Call"
    }
  ],
  "pinData": {},
  "connections": {
    "Error Trigger": {
      "main": [[{ "node": "Extract Failure Data", "type": "main", "index": 0 }]]
    },
    "Extract Failure Data": {
      "main": [
        [
          { "node": "Log to workflow_runs", "type": "main", "index": 0 },
          { "node": "Slack Alert to On-Call", "type": "main", "index": 0 }
        ]
      ]
    }
  },
  "active": false,
  "settings": { "executionOrder": "v1" },
  "meta": { "instanceId": "workflow-10-failure-watchdog" },
  "tags": []
}