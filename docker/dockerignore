# docker/.dockerignore
#
# This build context is the REPO ROOT (see docker-readme.md), so this file
# should live at the repo root as plain ".dockerignore" for Docker to pick
# it up automatically. Copy/rename it there:
#   cp docker/.dockerignore .dockerignore

# Dependencies (reinstalled fresh in every image)
node_modules
**/node_modules

# Version control & CI
.git
.gitignore
.github

# Environment & secrets — never bake these into an image
.env
.env.*
!.env.example

# Local build output (rebuilt inside the image anyway)
dist
build
.next
**/dist
**/build
**/.next

# Logs, caches, OS/editor junk
*.log
npm-debug.log*
.DS_Store
.vscode
.idea
coverage
.cache

# Docs & tests — not needed at runtime
docs
tests
**/*.test.js
**/*.spec.js
README.md
docker-readme.md
